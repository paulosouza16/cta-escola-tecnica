{
  "include": [
    "ctaescola/client/src/**/*",
    "ctaescola/shared/**/*",
    "ctaescola/server/**/*",
    "ctaescola/drizzle/**/*",
    "ctaescola/*.ts",
    "script.js"
  ],
  "exclude": ["node_modules", "build", "dist", "ctaescola/dist"],
  "compilerOptions": {
    "target": "ES2022",
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "module": "ESNext",
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "forceConsistentCasingInFileNames": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "react",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./ctaescola/client/src/*"],
      "@shared/*": ["./ctaescola/shared/*"]
    }
  }
}
