# Variáveis de ambiente para o back-end do Bolsão do CTA
# Copie este arquivo para .env no servidor (NUNCA faça commit do arquivo .env real)

PORT=3000
BOLSAO_EDICAO=[PREENCHER: código da edição — ex.: BOLSAO-CTA-2026]
SECRETARIA_EMAIL=[PREENCHER: e-mail da secretaria]

# Configurações SMTP para envio de e-mail ao candidato e à secretaria
SMTP_HOST=[PREENCHER: host SMTP — ex.: smtp.gmail.com]
SMTP_PORT=587
SMTP_USER=[PREENCHER: usuário/e-mail SMTP]
SMTP_PASS=[PREENCHER: senha de app SMTP]
SMTP_FROM="CTA Escola Técnica <[PREENCHER: e-mail remetente]>"

# ============================================================================
# FASE B — SECRETARIA ONLINE (FIREBASE CLOUD FUNCTIONS + STORAGE PRIVADO)
# ============================================================================
FIREBASE_PROJECT_ID=[PREENCHER: ID do projeto no Firebase]
FIREBASE_STORAGE_BUCKET=[PREENCHER: nome do bucket privado no Firebase Storage]
CPF_HASH_SALT=[PREENCHER: chave aleatória longa (32+ bytes) para HMAC-SHA256 do CPF]
SECRETARIA_MAX_FILE_BYTES=5242880
RESEND_API_KEY=[PREENCHER: chave da API do Resend para envio de e-mails transacionais]
EMAIL_FROM="Secretaria CTA <[PREENCHER: e-mail remetente verificado]>"
PAINEL_SECRETARIA_URL=https://ctarj.org.br/painel-secretaria.html


